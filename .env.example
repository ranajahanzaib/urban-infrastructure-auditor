# ==============================================================================
# Urban Infrastructure Auditor - Environment Configuration
# ==============================================================================

# Database Configuration (PostgreSQL 16 + PostGIS 3.4 + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=urban_infrastructure
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/urban_infrastructure?sslmode=disable

# Vision Service Configuration (Python / FastAPI)
VISION_PORT=8001
VISION_DEVICE=cpu # cpu, cuda, or mps (Apple Silicon)
SIGLIP_MODEL_ID=google/siglip-base-patch16-224
DINOV2_MODEL_ID=facebook/dinov2-base
VISION_SERVICE_URL=http://localhost:8001

# API Server Configuration (Go Chi)
PORT=8080
API_PORT=8080
ENVIRONMENT=development # development or production
STORAGE_DIR=data/storage # Absolute or relative path to local image assets

# Frontend Configuration (Next.js 15)
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080
